# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- OAuth (optional; leave blank to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Database ---
# A MongoDB Atlas (or any real MongoDB) connection string. When set, the API
# connects to this persistent database. When left blank, the API falls back
# to an ephemeral in-memory MongoDB for local development only -- data does
# NOT survive a restart in that mode, and it will NOT work in most cloud
# deployments (no writable disk / no outbound access to download the mongod
# binary). Set this for any real deployment.
MONGO_URI=

# --- AI ---
GEMINI_API_KEY=

# --- Honeypot ingestion ---
# Shared secret the honeypot listeners (services/honeypotManager.js) send as
# the x-ingest-key header when reporting incidents to POST /api/incidents.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HONEYPOT_INGEST_KEY=

# --- Networking ---
PORT=3001
# Public URL of the deployed frontend (e.g. https://decepshield.vercel.app).
# Used for CORS and for OAuth success/failure redirects back to the dashboard.
# Defaults to http://localhost:5173 for local dev if left blank.
FRONTEND_URL=
# Public URL of this deployed backend (e.g. https://decepshield-api.onrender.com).
# Used to build OAuth callback URLs registered with Google/GitHub/Discord.
# Defaults to http://localhost:3001 for local dev if left blank.
BACKEND_URL=
